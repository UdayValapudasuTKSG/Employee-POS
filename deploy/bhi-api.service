[Unit]
Description=BHI Health Card API
After=network.target postgresql.service

[Service]
Type=simple
User=ravinadhbiyyala
WorkingDirectory=/home/ravinadhbiyyala/health_insurance_card
EnvironmentFile=/home/ravinadhbiyyala/health_insurance_card/.env
ExecStart=/usr/bin/node --enable-source-maps artifacts/api-server/dist/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
