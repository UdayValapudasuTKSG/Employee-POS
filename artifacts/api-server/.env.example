# =============================================================================
# BHI Health Card Portal — BACKEND env file
# =============================================================================
#
#   Copy-Item artifacts/api-server/.env.example artifacts/api-server/.env
#   # then fill in every CHANGE_ME
#
# The project keeps exactly two env files:
#
#   artifacts/api-server/.env        backend  — this file: database, secrets,
#                                               email/SMS delivery, the card
#   artifacts/bhi-card-portal/.env   frontend — base URL, ports, proxy
#
# This file is read by the API, the SMS gateway, the compose stack's db,
# migrate, api and sms services, `pnpm run local` (which applies the LOCAL_*
# overrides at the bottom) and the Azure scripts in deploy/azure/.
#
# It holds live credentials. It is gitignored and dockerignored; keep it that
# way, and never paste its values into a chat, an issue or a commit message.
# =============================================================================


# --- Database ----------------------------------------------------------------
#
# ONE setting: the PostgreSQL connection, as a URL.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
#   USER / PASSWORD  the database login. It owns the tables and runs the
#                    migrations. (In the compose stack the Postgres container
#                    creates this login and the database from this URL on its
#                    first start.) Characters such as @ # / : in the password
#                    must be written URL-encoded: %40 %23 %2F %3A.
#   HOST             `db` in the compose stack (the service name — not
#                    localhost, which gives an API that restarts forever);
#                    127.0.0.1 to run on this machine; the server's name for a
#                    cloud database.
#   PORT             5432 unless your server says otherwise.
#   DATABASE         bhi_portal.
#
# For a cloud database add ?sslmode=require at the end.
#
# The API opens every connection as the restricted role bhi_app (created by the
# migrations), not as this login: it cannot delete anything, and row-level
# security keeps each company's data to its own users.
DATABASE_URL=postgresql://bhi_user:bhi_local_dev@db:5432/bhi_portal


# --- API ---------------------------------------------------------------------

# The production port. Containers have their own port space, so this does not
# collide with VS Code's extension host on 3001 — LOCAL_PORT covers the host.
PORT=3001

# 0.0.0.0 inside the compose stack: the API publishes no host port, so the
# container network is the isolation boundary and the front door remains the
# only way in. Binding loopback here would make the API unreachable from nginx.
HOST=0.0.0.0

# Exactly one proxy (nginx) sits in front. Without this, every audit row records
# nginx's address instead of the caller's.
TRUST_PROXY=1

NODE_ENV=production

# Signs session and OTP tokens. Startup fails if this is missing — it does not
# fall back to a default.
#   Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_to_a_long_random_string

# Unset means same-origin only, which is how nginx and the Vite dev proxy both
# serve the portal. Set it only when a frontend is served from a different
# origin than the API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# info | debug
# LOG_LEVEL=info


# --- Demo data ---------------------------------------------------------------

# Seeds 6 companies, 120 members, dependants and 5 admin accounts on first start
# against an empty database. Admin password: Demo@2026
#
# SYNTHETIC DATA ONLY. Never enable this against a database holding real member
# records — the seeded accounts use publicly documented passwords.
DEMO_SEED=true

# Ignored while DEMO_SEED=true. With seeding off, the first start against a
# database with no admin rows creates one group administrator from these.
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=CHANGE_ME_strong_password


# --- Email delivery (SMTP) ---------------------------------------------------
#
# SMTP_PASS for Gmail is a Google App Password, stored with NO spaces. SMTP_FROM
# must equal SMTP_USER or Gmail rejects the message. Port 587 is STARTTLS;
# otpDelivery.ts sets `secure` only for 465.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@yourdomain.com
SMTP_PASS=CHANGE_ME_google_app_password_no_spaces
# Unquoted on purpose — an env_file passes the value through verbatim.
SMTP_FROM=CHANGE_ME@yourdomain.com


# --- SMS delivery ------------------------------------------------------------
#
# The API posts {to, body} to the SMS gateway; the gateway normalises the number
# to E.164 and calls the provider. SMS_WEBHOOK_TOKEN is the shared secret both
# sides use — the gateway reads it from this same file.
SMS_WEBHOOK_URL=http://sms:2527/sms
SMS_WEBHOOK_TOKEN=CHANGE_ME_shared_secret_32_chars

# twilio | vonage | dryrun — dryrun exercises the whole path and sends nothing.
SMS_PROVIDER=twilio

# Twilio switch: ON sends real SMS (costs money). OFF sends nothing — the gateway
# refuses and the member is told the code cannot be delivered. Restart the SMS
# gateway after changing this.
TWILIO_ENABLED=ON

# Guyana. Only adds the country code to bare local numbers; +592... passes through.
SMS_DEFAULT_COUNTRY=592

# The gateway refuses to send anywhere else, and the API refuses to store a
# member number from anywhere else. Empty this to allow any country.
SMS_ALLOWED_COUNTRY=592

# Logs the message text, which contains the verification code. Dev only.
SMS_GATEWAY_LOG_BODY=false

# TWILIO_FROM must be a number this account owns, or Twilio rejects the send with
# error 21606. Or use a Messaging Service SID instead — never both.
TWILIO_ACCOUNT_SID=CHANGE_ME_starts_with_AC
TWILIO_AUTH_TOKEN=CHANGE_ME_twilio_auth_token
TWILIO_FROM=+CHANGE_ME_number_this_account_owns
# TWILIO_MESSAGING_SERVICE_SID=

# false → real delivery.
# true  → delivery is skipped and the code comes back inline as `devCode`.
#         Required by the RBAC suite; wrong for everything else.
OTP_DEV_MODE=false

# Diverts every member's card to one address. Useful only for demoing with
# seeded members whose fabricated addresses cannot receive mail.
# CARD_EMAIL_OVERRIDE=


# --- Card issuer -------------------------------------------------------------
#
# What the card says about who issued it. Not secret. Anything left blank is
# omitted from the card rather than replaced by a default.

ISSUER_NAME=North American Life Insurance Co. Ltd.
ISSUER_ADDRESS=30/31 Regent & Hincks Sts, Georgetown
ISSUER_PHONE=Tel No: 592-226-5885 - 8
ISSUER_SIGNATORY_NAME=L. Singh
ISSUER_SIGNATORY_TITLE=Life Manager
CARD_PROPERTY_NOTICE=This Card is the Property of NALICO. If found please return to NALICO, 30/31 Regent & Hincks Sts, Georgetown, Guyana
ISSUER_PLAN_TITLE=
CARD_BACK_NOTICE=


# --- Employee discounts ------------------------------------------------------
#
# Members generate a single-use QR coupon for KFC or Pizza Hut; that brand's
# POS redeems it through /api/v1/pos/coupons (docs/POS-DISCOUNT-API.md). The
# discount is DISCOUNT_PERCENT of the bill, never more than what is left of the
# member's monthly allowance — DISCOUNT_MONTHLY_CAP_GYD of discount per
# calendar month in Guyana time, shared across both brands.
# DISCOUNT_PERCENT=10
# DISCOUNT_MONTHLY_CAP_GYD=15000
# How long a generated coupon can be redeemed for.
# DISCOUNT_COUPON_TTL_MINUTES=30

# One key per brand, given to that brand's POS vendor; a POS sends it as
# "Authorization: Bearer <key>" and can only redeem its own brand's coupons.
# Unset (or under 24 characters) = that brand cannot redeem anything.
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# POS_API_KEY_KFC=
# POS_API_KEY_PIZZA_HUT=


# --- Azure App Service only (deploy/azure/*.ps1) -----------------------------
#
# The PostgreSQL admin password, set when the Azure server is created. Write
# the raw password; the scripts pass it without a URL.
# Everything else Azure needs is read from the keys above or computed by
# deploy/azure/04-create-app.ps1.
# PG_ADMIN_PASSWORD=CHANGE_ME


# =============================================================================
# LOCAL_* — the non-Docker path (`pnpm run local`) only
# =============================================================================
#
# These values differ between running in a container and running on the host.
# deploy/load-env.mjs applies any LOCAL_* value over the key of the same
# name; the compose stack never reads the prefix.
LOCAL_HOST=127.0.0.1
LOCAL_PORT=3001
LOCAL_SMS_WEBHOOK_URL=http://127.0.0.1:2527/sms
