# =============================================================================
# BHI Health Card Portal — FRONTEND env file
# =============================================================================
#
#   Copy-Item artifacts/bhi-card-portal/.env.example artifacts/bhi-card-portal/.env
#
# The project keeps exactly two env files:
#
#   artifacts/api-server/.env        backend  — database, secrets, delivery, card
#   artifacts/bhi-card-portal/.env   frontend — this file: base URL, ports, proxy
#
# Nothing in here is secret, and nothing in here reaches the browser bundle:
# Vite only exposes VITE_* keys to client code, and there are none.
#
# Read by:
#   vite.config.ts             PORT, BASE_PATH, API_PROXY_TARGET
#   deploy/serve-local.mjs     WEB_PORT, API_PROXY_TARGET, OTP_ACCEPT_ANY
#   deploy/start-local.mjs     WEB_PORT, OTP_ACCEPT_ANY
#   compose.yaml (web)         WEB_PORT, RATE_*
#
# Anything already set in the shell wins over this file.
# =============================================================================


# --- Vite dev server (pnpm --filter @workspace/bhi-card-portal run dev) ------

# The dev server's port.
PORT=3000

# The base URL the app is served under: "/" or a single segment such as
# "/portal". Every asset URL and the client-side router are prefixed with it.
BASE_PATH=/

# Where /api is proxied to — the dev server by Vite, and the local front door
# (deploy/serve-local.mjs) when run on its own. Must match the API's port in
# artifacts/api-server/.env (LOCAL_PORT there, 3001 by default). The one-command
# launcher (pnpm run local) derives it from that file itself and ignores this.
API_PROXY_TARGET=http://127.0.0.1:3001


# --- Front door (pnpm run local, and the compose `web` service) -------------

# Host port for the portal. Change it if 3000 is taken.
WEB_PORT=3000

# Local front door only: "false" makes it require the real verification code
# instead of accepting any 6-digit code. Production (nginx) always checks.
# OTP_ACCEPT_ANY=false


# --- nginx rate limits (compose `web` service) -------------------------------
#
# Default to the exact production values in deploy/nginx/bhi-portal-limits.conf,
# so a 429 you would hit in production is a 429 you hit locally. Raise RATE_API
# when running the RBAC suite — 79 assertions against 120r/m is close to the
# ceiling.
RATE_LOOKUP=10r/m
RATE_ADMIN_LOGIN=5r/m
RATE_API=120r/m
