{
  "name": "beharry-employee-discounts",
  "version": "1.0.0",
  "private": true,
  "description": "Beharry staff discounts: one code, any participating store. Web app and API in one service.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "25.9.5",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.27.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-qr-code": "2.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "wouter": "3.10.0"
  }
}
