# =============================================================================
# Beharry Staff Discounts — settings
#
#   cp .env.example .env     then fill in every CHANGE_ME
#
# Read by the app (npm run dev:server / npm start) and by docker-compose.yml.
# .env holds secrets: it is git-ignored. Never commit it or paste it anywhere.
# =============================================================================

# --- Running ------------------------------------------------------------------
# production in any real deployment: secure cookies, and OTP_DEV_MODE refused.
NODE_ENV=production
PORT=3200
# The address people open; used in emails.
APP_URL=http://localhost:3200
# Behind nginx or a load balancer: the number of proxies in front (usually 1).
# TRUST_PROXY=1

# Protects sessions and encrypts stored codes. At least 32 characters. Changing it signs everyone out and makes live codes unreadable.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME

# How long a sign-in lasts, in hours.
# SESSION_HOURS=8

# --- Database -----------------------------------------------------------------
# Any empty PostgreSQL 14+ database works: the app creates its tables on first
# start (db/migrations) and adds the seed employees (server/seed.ts).
# For `npm run dev:server` on this machine against the compose database:
DATABASE_URL=postgresql://discounts:CHANGE_ME@127.0.0.1:5435/discounts
# docker-compose.yml only: the database password (also in DATABASE_URL above),
# and the host ports.
DB_PASSWORD=CHANGE_ME
# DB_PORT=5435
# APP_PORT=3200

# --- Admin portal -------------------------------------------------------------
# Who can sign in at /admin: comma-separated emails. They sign in with an
# emailed code. Remove an address and restart to take access away.
ADMIN_EMAILS=CHANGE_ME@beharrygroup.com

# --- The discount -------------------------------------------------------------
# FIRST-START DEFAULTS ONLY. On its first start the app copies these into the
# database; after that, change them in the admin portal (Discounts), where each
# store also gets its own percentage and optional monthly limit.
# Percentage off the bill, the most an employee can save per month (GYD, all
# stores together, renewing on the 1st in Guyana time), and how long a code lasts.
DISCOUNT_PERCENT=10
DISCOUNT_MONTHLY_CAP_GYD=15000
CODE_TTL_MINUTES=30

# --- Email (SMTP) -------------------------------------------------------------
# Sign-in codes, confirmation codes and the discount code are emailed. Gmail:
# smtp.gmail.com, port 587, an App Password (no spaces), SMTP_FROM = SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=CHANGE_ME

# true: codes come back on screen instead of by email. Local testing only;
# refused when NODE_ENV=production.
OTP_DEV_MODE=false

# --- Store tills (POS) --------------------------------------------------------
# One key per store, given to that store's POS vendor; at least 24 characters.
# A till sends it as "Authorization: Bearer <key>". Unset = that store cannot redeem.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
POS_KEY_KFC=
POS_KEY_PIZZA_HUT=
POS_KEY_STERLING=
POS_KEY_BEHARRY=

# --- Seed ---------------------------------------------------------------------
# Add the named employees in server/seed.ts on start (missing ones only).
SEED_EMPLOYEES=true
# Also add made-up employees on @example.test, for testing with OTP_DEV_MODE.
SEED_DEMO_EMPLOYEES=false
